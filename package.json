{
  "name": "mooncrust-cli",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:win && npm run build:linux",
    "build:win": "pkg . --options no-warnings --targets node18-win-x64 --output dist/mooncrust-win.exe",
    "build:linux": "pkg . --options no-warnings --targets node18-linux-x64 --output dist/mooncrust-linux",
    "test": "node --test test/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "chalk": "^4.1.2",
    "figlet": "^1.12.0"
  },
  "bin": {
    "mooncrust": "./index.js"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "node_modules/figlet/fonts/Slant.flf"
    ],
    "outputPath": "dist"
  }
}
